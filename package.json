{
  "name": "gymlog",
  "version": "1.1.0",
  "private": true,
  "description": "Installable offline-first training PWA with smart workout logging, tested local persistence, progress metrics and portable backups",
  "license": "MIT",
  "author": "Alessandro Di Terlizzi",
  "homepage": "https://gymlog.aledtr-77.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aledtr77/gymlog.git"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview --host",
    "test": "node --test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "bash scripts/release.sh",
    "badge": "node scripts/sync-test-badge.mjs",
    "badge:check": "node scripts/sync-test-badge.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.9.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.10",
    "wrangler": "^4.119.0"
  }
}
